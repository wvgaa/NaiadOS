# NaiadOS kernel: latest stable, debloated
pkgname=linux-naiados
_suffix=naiados
pkgver=7.2.7
pkgrel=3
pkgdesc="The NaiadOS kernel (latest stable, debloated)"
arch=(x86_64)
url="https://www.kernel.org"
license=(GPL-2.0-only)
depends=(coreutils kmod mkinitcpio)
makedepends=(bc cpio gettext libelf openssl pahole perl python tar xz zstd)
options=(!debug !strip)
source=("https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz"
        "https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.sign"
        config
        initramfs.sh
        90-$pkgname.hook
        60-$pkgname-remove.hook)
sha256sums=('4ac34c47db2540ffb2713943f8d891ff1702e0ba6934525a493b7d1cad43145a'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')
# kernel.org release keys: Linus Torvalds, Greg Kroah-Hartman, Sasha Levin
validpgpkeys=(ABAF11C65A2970B130ABE3C479BE3E4300411886
              647F28654894E3BD457199BE38DBBDC86092693E
              E27E5D8A3403A2EF66873BBCDEA66FF797772CDC)

prepare() {
  cd "linux-$pkgver"
  cp ../config .config
  # baked in so modules land in /usr/lib/modules/<ver>-$_suffix
  scripts/config --set-str LOCALVERSION "-$_suffix" --disable LOCALVERSION_AUTO
  make olddefconfig
}

build() {
  cd "linux-$pkgver"
  make -j"$(nproc)" bzImage modules
}

package() {
  cd "linux-$pkgver"
  local kernver="$(make -s kernelrelease)"

  install -Dm644 "$(make -s image_name)" "$pkgdir/boot/vmlinuz-$_suffix"
  install -Dm644 .config "$pkgdir/boot/config-$_suffix"

  ZSTD_CLEVEL=19 make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 modules_install
  # points into the makepkg build dir, which won't exist on the target
  rm -f "$pkgdir/usr/lib/modules/$kernver/build"

  # regenerate the initramfs on kernel/mkinitcpio/firmware updates
  install -Dm755 ../initramfs.sh "$pkgdir/usr/share/libalpm/scripts/$pkgname-initramfs"
  install -Dm644 ../90-$pkgname.hook "$pkgdir/usr/share/libalpm/hooks/90-$pkgname.hook"
  install -Dm644 ../60-$pkgname-remove.hook "$pkgdir/usr/share/libalpm/hooks/60-$pkgname-remove.hook"
}
