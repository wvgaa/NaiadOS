[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = boot/vmlinuz-naiados
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/src/*/dkms.conf

[Action]
Description = Updating linux-naiados initramfs...
When = PostTransaction
Exec = /usr/share/libalpm/scripts/linux-naiados-initramfs
